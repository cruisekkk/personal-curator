{% extends "base.html.j2" %}
{% block title %}Curator · Archive{% endblock %}
{% block content %}
<header class="pagehead">
  <h1>Curator</h1>
  <p class="statline">Feeds in → one page a day · local first</p>
</header>

{% for wk, items in entries | groupby('week') | reverse %}
<section class="weekgroup">
  <h2><a href="weekly/{{ wk }}.html">{{ wk }} weekly page →</a></h2>
  <ul class="indexlist">
  {% for it in items | sort(attribute='date', reverse=true) %}
    {% if it.gap %}
    <li class="gaprow">
      <span class="idxdate muted">{{ it.date }} {{ it.weekday }}</span>
      <span class="muted">no daily digest{% if wk in weekly_keys %} · <a href="weekly/{{ wk }}.html">see the weekly review</a>{% endif %}</span>
    </li>
    {% else %}
    <li>
      <a class="idxdate" href="daily/{{ it.date }}.html">{{ it.date }} {{ it.weekday }}</a>
      <span class="muted">{{ it.stats.est_read_min }} min · {{ it.stats.events }} events{% if it.stats.deep_reads %} · {{ it.stats.deep_reads }} deep read{{ 's' if it.stats.deep_reads > 1 }}{% endif %}</span>
      <span class="idxtop">{{ it.top_title }}</span>
    </li>
    {% endif %}
  {% endfor %}
  </ul>
</section>
{% endfor %}
{% endblock %}
